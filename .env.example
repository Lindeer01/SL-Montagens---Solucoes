# Modelo das variaveis de ambiente. NAO coloque chaves reais neste arquivo.
# Copie para .env.local e preencha com os valores do seu projeto no Supabase.
# Onde achar: painel do Supabase > botao "Connect" (ou Project Settings > API / API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_AQUI

# NUNCA coloque aqui a "secret key" nem a "service_role": elas dao acesso total ao banco.